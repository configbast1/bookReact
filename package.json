{
  "name": "bookstore-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Книжный интернет-магазин на React: ООП-ядро, Redux Toolkit, Context, json-server",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "server": "json-server --watch db.json --port 3001",
    "start": "concurrently \"npm:server\" \"npm:dev\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "json-server": "^0.17.4",
    "vite": "^5.4.8"
  }
}
